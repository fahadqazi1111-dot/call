# ================================================================
# CALL — production environment template
# Copy to `.env` BEFORE running `npm run build`
# (NEXT_PUBLIC_* values are baked into the client bundle at build time!)
# ================================================================

# --- Database (MySQL on your hosting) ----------------------------
# Create the DB in your hosting panel (or phpMyAdmin), then import
# deploy/call-mysql-full.sql — tables + your data arrive together.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME"

# --- Realtime (keep the defaults; socket.io runs in the SAME ----
# --- Node process as Next.js — one port, nothing else to start) --
NEXT_PUBLIC_SOCKET_URL="/"
NEXT_PUBLIC_SOCKET_PATH="/socket.io/"

# --- WebRTC ICE / TURN servers (NEXT_PUBLIC_* — baked at build) --
# LEAVE BLANK to use the built-in FREE public STUN + TURN servers.
# The app ships with Google STUN + OpenRelay TURN (metered.ca, free, no signup)
# as defaults — calls, live streams, and voice rooms work cross-network out of
# the box (mobile 4G/5G included). No configuration needed.
#
# Only set this if you want to use your OWN dedicated TURN server (for scale
# or to avoid the free public servers' rate limits):
#   NEXT_PUBLIC_CALL_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn.com:3478","username":"u","credential":"c"}]'
NEXT_PUBLIC_CALL_ICE_SERVERS=""

# --- Public URL of the deployed app ------------------------------
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- Server-side -------------------------------------------------
# Port the Node process listens on (hosting panels usually set this)
PORT=3000
# Internal realtime relay — mounted on the MAIN http server at /internal/*
# (Hostinger shared "Node.js" hosting only allows ONE port per process, so
# the relay can no longer bind a second loopback port like 3004).
# Leave this commented — deploy/production-server.js sets it automatically to
# http://127.0.0.1:${PORT}/internal/relay at startup.
# CALL_RELAY_URL="http://127.0.0.1:3000/internal/relay"
